RewriteEngine On


# GODADDY / LIVE SITE — upload this as .htaccess in public_html on deploy


# FORCE HTTPS + NON-WWW (CANONICAL URL)

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.srishankaracancerhospital\.org$ [NC]
RewriteRule ^ https://srishankaracancerhospital.org%{REQUEST_URI} [R=301,L]


# REMOVE TRAILING SLASH

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]


# REMOVE .HTML FROM URL (SEO CLEAN URL)

RewriteCond %{THE_REQUEST} \s/([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]


# INTERNALLY MAP CLEAN URL → .HTML FILE

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]


Options -Indexes

ErrorDocument 404 /404.html
